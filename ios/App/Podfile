require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '16.0'
project 'App.xcodeproj'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityStripe', :path => '../../node_modules/@capacitor-community/stripe'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorCamera', :path => '../../node_modules/@capacitor/camera'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapawesomeCapacitorBadge', :path => '../../node_modules/@capawesome/capacitor-badge'
end

target 'Gigejob' do
  capacitor_pods
  # Add your Pods here
  pod 'CapacitorFirebaseAuthentication/Google', :path => '../../node_modules/@capacitor-firebase/authentication'
end

post_install do |installer|
  assertDeploymentTarget(installer)
  installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
          if target.respond_to?(:product_type) and target.product_type == "com.apple.product-type.bundle"
              target.build_configurations.each do |config|
                  config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
              end
          end
      end
  end

  # Fix StripeCore visionOS compatibility issue on Xcode 16 / iOS
  patch_files = Dir.glob(File.join(__dir__ || Dir.pwd, '**/Locale+StripeCore.swift'))
  if patch_files.empty? && defined?(installer) && installer.respond_to?(:sandbox)
    patch_files = Dir.glob(File.join(installer.sandbox.root, '**/Locale+StripeCore.swift'))
  end
  if patch_files.empty?
    patch_files = Dir.glob('**/Locale+StripeCore.swift')
  end

  patch_files.each do |file_path|
    if File.exist?(file_path)
      File.chmod(0644, file_path)
      content = File.read(file_path)
      if content.include?('canImport(CompositorServices)')
        content.gsub!('canImport(CompositorServices)', 'os(visionOS)')
        File.write(file_path, content)
        puts "[Podfile] Successfully patched StripeCore at: #{file_path}"
      end
    end
  end
end
